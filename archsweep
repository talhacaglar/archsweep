#!/usr/bin/env bash
#
# archsweep — a tiny, dependency-free TUI to clean common junk on Arch-based systems.
#
# Pure bash. No fzf, gum, dialog or whiptail required — only pacman + coreutils.
# Arrow keys / j,k to move · space to toggle · a to (de)select all · enter to run · q to quit.
#
# https://github.com/<your-name>/archsweep
# License: MIT

set -uo pipefail

# ----------------------------- configuration --------------------------------
# How many versions of each package to keep in the pacman cache.
KEEP_VERSIONS="${ARCHSWEEP_KEEP_VERSIONS:-2}"
# systemd journal retention when vacuuming (see `man journalctl`: --vacuum-time).
JOURNAL_KEEP="${ARCHSWEEP_JOURNAL_KEEP:-2weeks}"

# ----------------------------- colors / tty ---------------------------------
if [[ -t 1 ]]; then
  BOLD=$'\e[1m'; DIM=$'\e[2m'; RESET=$'\e[0m'
  CYAN=$'\e[36m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; RED=$'\e[31m'
  MAGENTA=$'\e[35m'; BLUE=$'\e[34m'; GREY=$'\e[90m'; REV=$'\e[7m'
else
  BOLD=""; DIM=""; RESET=""; CYAN=""; GREEN=""; YELLOW=""; RED=""
  MAGENTA=""; BLUE=""; GREY=""; REV=""
fi

die()  { printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
info() { printf '%s==>%s %s%s%s\n' "$CYAN" "$RESET" "$BOLD" "$*" "$RESET"; }

command -v pacman >/dev/null 2>&1 || die "this tool is for Arch-based systems (pacman not found)."

# Detect an AUR helper, if any.
AUR_HELPER=""
for h in paru yay; do
  if command -v "$h" >/dev/null 2>&1; then AUR_HELPER="$h"; break; fi
done

# paccache ships with pacman-contrib; degrade gracefully if it is missing.
HAVE_PACCACHE=1
command -v paccache >/dev/null 2>&1 || HAVE_PACCACHE=0

# ----------------------------- task definitions -----------------------------
# Each task has: an id, a human label, a measure__<id> (prints a short status
# shown in the menu) and a run__<id> (performs the cleanup).

measure__orphans() {
  local n; n=$(pacman -Qdtq 2>/dev/null | wc -l)
  (( n == 0 )) && printf 'nothing' || printf '%d package(s)' "$n"
}
run__orphans() {
  local list; list=$(pacman -Qdtq 2>/dev/null || true)
  if [[ -z "$list" ]]; then echo "  no orphans, skipping."; return 0; fi
  echo "$list" | sudo pacman -Rns --noconfirm -
}

measure__cache_old() {
  (( HAVE_PACCACHE )) || { printf 'needs pacman-contrib'; return; }
  paccache -dk"$KEEP_VERSIONS" 2>/dev/null \
    | grep -oP 'disk space saved: \K[0-9.]+\s?\w+' || printf 'nothing'
}
run__cache_old() {
  (( HAVE_PACCACHE )) || { echo "  paccache missing (install pacman-contrib)."; return 0; }
  sudo paccache -rk"$KEEP_VERSIONS"
}

measure__cache_uninstalled() {
  (( HAVE_PACCACHE )) || { printf 'needs pacman-contrib'; return; }
  paccache -duk0 2>/dev/null \
    | grep -oP 'disk space saved: \K[0-9.]+\s?\w+' || printf 'nothing'
}
run__cache_uninstalled() {
  (( HAVE_PACCACHE )) || { echo "  paccache missing (install pacman-contrib)."; return 0; }
  sudo paccache -ruk0
}

measure__aur_cache() {
  [[ -z "$AUR_HELPER" ]] && { printf 'no AUR helper'; return; }
  local d="$HOME/.cache/$AUR_HELPER"
  [[ -d "$d" ]] && du -sh "$d" 2>/dev/null | cut -f1 || printf 'nothing'
}
run__aur_cache() {
  [[ -z "$AUR_HELPER" ]] && { echo "  no AUR helper found, skipping."; return 0; }
  # AUR helpers refuse to run as root, so this stays unprivileged on purpose.
  "$AUR_HELPER" -Sc --noconfirm
}

measure__journal() {
  command -v journalctl >/dev/null 2>&1 || { printf 'no journald'; return; }
  journalctl --disk-usage 2>/dev/null | grep -oP 'take up \K[0-9.]+\s?\w+' || printf '?'
}
run__journal() {
  command -v journalctl >/dev/null 2>&1 || { echo "  journalctl not found, skipping."; return 0; }
  sudo journalctl --vacuum-time="$JOURNAL_KEEP"
}

# Registry (order = menu order).
IDS=(orphans cache_old cache_uninstalled aur_cache journal)
declare -A LABEL=(
  [orphans]="Orphan packages"
  [cache_old]="Pacman cache (keep $KEEP_VERSIONS)"
  [cache_uninstalled]="Cache of removed packages"
  [aur_cache]="AUR helper cache${AUR_HELPER:+ ($AUR_HELPER)}"
  [journal]="Systemd journal (keep $JOURNAL_KEEP)"
)
declare -A DESC=(
  [orphans]="Installed as deps, now needed by nothing  ·  pacman -Rns"
  [cache_old]="Older versions in /var/cache/pacman/pkg  ·  paccache -rk$KEEP_VERSIONS"
  [cache_uninstalled]="Packages you no longer have installed  ·  paccache -ruk0"
  [aur_cache]="Build files and git clones from your AUR helper  ·  -Sc"
  [journal]="Logs older than the retention window  ·  journalctl --vacuum-time"
)

N=${#IDS[@]}
declare -a SELECTED MEASURE
for ((i=0; i<N; i++)); do SELECTED[i]=1; done   # everything pre-selected; all are safe

# ----------------------------- TUI rendering --------------------------------
CUR=0

restore_term() { printf '\e[?25h'; }            # show cursor again
trap restore_term EXIT
printf '\e[?25l'                                 # hide cursor during the menu

measure_all() {
  for ((i=0; i<N; i++)); do MEASURE[i]="$("measure__${IDS[i]}")"; done
}

# Repeat a string n times (for borders/rules).
repeat() { local n=$1 s=$2 out=""; while (( n-- > 0 )); do out+="$s"; done; printf '%s' "$out"; }

# Color a measured value: green when it's a real size/count, dim otherwise.
paint_size() {
  if [[ "$1" =~ ^[0-9] ]]; then printf '%s%s%s' "$GREEN" "$1" "$RESET"
  else printf '%s%s%s' "$GREY" "$1" "$RESET"; fi
}

# Centered, rounded title box sized to its text.
banner() {
  local plain="  archsweep  ·  tidy your Arch system  "
  local disp="  ${BOLD}${MAGENTA}archsweep${RESET}  ${DIM}·${RESET}  ${DIM}tidy your Arch system${RESET}  "
  local w=${#plain}
  printf '  %s╭%s╮%s\n'  "$CYAN" "$(repeat "$w" ─)" "$RESET"
  printf '  %s│%s%s%s│%s\n' "$CYAN" "$RESET" "$disp" "$CYAN" "$RESET"
  printf '  %s╰%s╯%s\n'  "$CYAN" "$(repeat "$w" ─)" "$RESET"
}

draw() {
  printf '\e[H\e[2J'   # home + clear
  printf '\n'; banner; printf '\n'
  local sel=0
  for ((i=0; i<N; i++)); do
    (( SELECTED[i] )) && (( sel++ ))
    local bar=" " cb lstart="$RESET"
    if (( SELECTED[i] )); then cb="${GREEN}◉${RESET}"; else cb="${GREY}○${RESET}"; fi
    if (( i == CUR )); then bar="${CYAN}${BOLD}▌${RESET}"; lstart="$BOLD"; fi
    # Right-align the size by padding on its plain length (color codes don't count).
    local m="${MEASURE[i]:-…}"
    local pad=$(( 12 - ${#m} )); (( pad < 0 )) && pad=0
    printf '  %s %s  %s%-30s%s%*s%s\n' \
      "$bar" "$cb" "$lstart" "${LABEL[${IDS[i]}]}" "$RESET" "$pad" "" "$(paint_size "$m")"
  done
  # Contextual one-line description of the highlighted task.
  printf '\n   %s%s%s\n' "$DIM" "${DESC[${IDS[CUR]}]}" "$RESET"
  # Footer.
  printf '  %s%s%s\n' "$GREY" "$(repeat 44 ─)" "$RESET"
  printf '  %s%s↑↓%s move   %sspace%s pick   %sa%s all   %s⏎%s run   %sq%s quit   %s· %d selected%s\n' \
    "" "$BOLD$CYAN" "$RESET" "$BOLD$CYAN" "$RESET" "$BOLD$CYAN" "$RESET" \
    "$BOLD$GREEN" "$RESET" "$BOLD$RED" "$RESET" "$DIM" "$sel" "$RESET"
}

read_key() {
  local k rest
  IFS= read -rsn1 k
  if [[ $k == $'\e' ]]; then
    read -rsn2 -t 0.0005 rest 2>/dev/null || true
    k+="$rest"
  fi
  printf '%s' "$k"
}

# ----------------------------- main loop ------------------------------------
measure_all
while true; do
  draw
  key=$(read_key)
  case "$key" in
    $'\e[A'|k) (( CUR = (CUR - 1 + N) % N )) ;;
    $'\e[B'|j) (( CUR = (CUR + 1) % N )) ;;
    ' ')       SELECTED[CUR]=$(( 1 - SELECTED[CUR] )) ;;
    a)
      any=0
      for ((i=0; i<N; i++)); do (( SELECTED[i] )) && any=1; done
      for ((i=0; i<N; i++)); do SELECTED[i]=$(( any ? 0 : 1 )); done ;;
    q|$'\e') printf '\e[H\e[2J'; echo "Cancelled."; exit 0 ;;
    '')      break ;;   # Enter
  esac
done

# ----------------------------- confirm & run --------------------------------
printf '\e[H\e[2J'
chosen=()
for ((i=0; i<N; i++)); do (( SELECTED[i] )) && chosen+=("${IDS[i]}"); done
if (( ${#chosen[@]} == 0 )); then echo "Nothing selected. Bye."; exit 0; fi

before=$(df --output=avail -BM / 2>/dev/null | tail -1 | tr -dc '0-9')

printf '\n'; banner; printf '\n'
printf '  %sThe following tasks will run:%s\n\n' "$BOLD" "$RESET"
for id in "${chosen[@]}"; do printf '    %s•%s %s\n' "$CYAN" "$RESET" "${LABEL[$id]}"; done
printf '\n  %s%sProceed?%s %s[y/N]%s ' "$BOLD" "$YELLOW" "$RESET" "$DIM" "$RESET"
read -r ans
[[ "$ans" =~ ^[Yy]$ ]] || { printf '  %sAborted.%s\n' "$DIM" "$RESET"; exit 0; }

# Cache sudo credentials up front (only if a privileged task is selected).
for id in "${chosen[@]}"; do
  if [[ "$id" != "aur_cache" ]]; then sudo -v || die "sudo is required."; break; fi
done

echo
for id in "${chosen[@]}"; do
  info "${LABEL[$id]}"
  if "run__$id"; then
    printf '  %s✓%s done\n\n' "$GREEN" "$RESET"
  else
    printf '  %s✗ task reported an error, continuing%s\n\n' "$YELLOW" "$RESET"
  fi
done

after=$(df --output=avail -BM / 2>/dev/null | tail -1 | tr -dc '0-9')
printf '  %s%s%s\n' "$GREY" "$(repeat 44 ─)" "$RESET"
if [[ -n "${before:-}" && -n "${after:-}" ]]; then
  freed=$(( after - before )); (( freed < 0 )) && freed=0
  printf '  %s%s✓ All done.%s  Freed %s~%s MiB%s on /\n' \
    "$BOLD" "$GREEN" "$RESET" "$BOLD" "$freed" "$RESET"
else
  printf '  %s%s✓ All done.%s\n' "$BOLD" "$GREEN" "$RESET"
fi
